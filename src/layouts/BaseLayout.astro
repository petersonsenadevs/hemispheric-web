---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import alaArribaImg from '../assets/brand/cuervo-ala-arriba.png';
import alaAbajoImg from '../assets/brand/cuervo-ala-abajo.png';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** When true the main content sits under the fixed nav (hero paints behind it). */
  heroOverlay?: boolean;
  /** True on pages that have a Spanish version (the landing); emits hreflang alternates. */
  hasEs?: boolean;
}

const {
  title = 'Corvusmem — Memory for your agent',
  description = 'Free, offline, deterministic memory for your coding agent. No server, no embeddings, no API key. Works where you already work: Claude Code, Codex and more.',
  heroOverlay = false,
  hasEs = false,
} = Astro.props;

const lang = Astro.currentLocale ?? 'en';
const site = (Astro.site?.href ?? 'https://corvusmem.vercel.app/').replace(/\/$/, '');
const basePath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enUrl = site + basePath;
const esUrl = site + (basePath === '/' ? '/es/' : '/es' + basePath);
const canonical = site + Astro.url.pathname;
const ogImage = `${site}/og-image.png`;
// Loader con aleteo: dos fotogramas (alas arriba/abajo) optimizados a webp
const alaArriba = await getImage({ src: alaArribaImg, width: 300, format: 'webp' });
const alaAbajo = await getImage({ src: alaAbajoImg, width: 300, format: 'webp' });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-crow.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {hasEs && <link rel="alternate" hreflang="en" href={enUrl} />}
    {hasEs && <link rel="alternate" hreflang="es" href={esUrl} />}
    {hasEs && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {/* Anti-flash: apply the saved theme before first paint. Default is dark. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('theme') === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div id="brand-loader" aria-hidden="true" style="position:fixed;inset:0;z-index:200;display:grid;place-items:center;background:var(--background);">
      <div class="bl-inner">
        <div class="bl-crow" aria-hidden="true">
          <img src={alaArriba.src} alt="" class="bl-wing bl-wing-up" width="300" height="300" fetchpriority="high" />
          <img src={alaAbajo.src} alt="" class="bl-wing bl-wing-down" width="300" height="300" />
        </div>
        <span class="bl-word">Corvusmem<span class="bl-dot">.</span></span>
      </div>
    </div>
    <style is:global>
      #brand-loader { transition: opacity var(--duration-slow, 400ms) var(--ease-out, ease); }
      #brand-loader.is-hidden { opacity: 0; pointer-events: none; }
      #brand-loader .bl-inner { display: grid; justify-items: center; gap: 14px; }
      #brand-loader .bl-crow { position: relative; width: clamp(84px, 14vw, 150px); aspect-ratio: 1; opacity: .95; }
      #brand-loader .bl-wing { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
      #brand-loader .bl-wing-down { opacity: 0; }
      @media (prefers-reduced-motion: no-preference) {
        #brand-loader .bl-wing-up { animation: bl-flap-up .32s linear infinite; }
        #brand-loader .bl-wing-down { animation: bl-flap-down .32s linear infinite; }
      }
      @keyframes bl-flap-up { 0%, 49.9% { opacity: 1; } 50%, 100% { opacity: 0; } }
      @keyframes bl-flap-down { 0%, 49.9% { opacity: 0; } 50%, 100% { opacity: 1; } }
      #brand-loader .bl-word { font-family: var(--font-display); font-size: clamp(2rem, 6vw, 4rem); color: var(--foreground); letter-spacing: -0.01em; }
      #brand-loader .bl-dot { color: var(--accent); }
      @media (prefers-reduced-motion: reduce) { #brand-loader { transition: none; } }

      /* --- F14: vida (reveals al scroll + float), sin dependencias --- */
      /* Solo con JS (html.js): sin JS el contenido se ve siempre. */
      @media (prefers-reduced-motion: no-preference) {
        html.js [data-reveal] {
          opacity: 0;
          transform: translateY(18px);
          transition: opacity 0.7s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
                      transform 0.7s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
          transition-delay: var(--reveal-delay, 0ms);
          will-change: opacity, transform;
        }
        html.js [data-reveal].is-visible { opacity: 1; transform: none; }
        /* Flotación muy sutil (cuervo del hero, acentos) */
        [data-float] { animation: hemi-float 7s ease-in-out infinite; }
        @keyframes hemi-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

        /* Hover-lift en tarjetas de superficie */
        .rounded-2xl.bg-surface { transition: transform .25s var(--ease-out, ease), border-color .25s, box-shadow .25s; }
        /* Glow en los botones de acento (CTA) */
        .bg-accent { transition: box-shadow .3s var(--ease-out, ease), transform .2s, opacity .2s; }
        /* Stagger: hijos de un contenedor [data-stagger] entran en cascada */
        html.js [data-stagger] > * { opacity: 0; transform: translateY(14px); transition: opacity .6s var(--ease-out, cubic-bezier(.22,1,.36,1)), transform .6s var(--ease-out, cubic-bezier(.22,1,.36,1)); }
        html.js [data-stagger].is-visible > * { opacity: 1; transform: none; }
        html.js [data-stagger].is-visible > *:nth-child(1) { transition-delay: 60ms; }
        html.js [data-stagger].is-visible > *:nth-child(2) { transition-delay: 160ms; }
        html.js [data-stagger].is-visible > *:nth-child(3) { transition-delay: 260ms; }
        html.js [data-stagger].is-visible > *:nth-child(4) { transition-delay: 360ms; }
        html.js [data-stagger].is-visible > *:nth-child(5) { transition-delay: 460ms; }
        html.js [data-stagger].is-visible > *:nth-child(n+6) { transition-delay: 540ms; }
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .rounded-2xl.bg-surface:hover { transform: translateY(-4px); border-color: var(--border-strong); box-shadow: 0 14px 34px -14px rgba(0,0,0,.45); }
        .bg-accent:hover { box-shadow: 0 0 0 1px var(--accent), 0 10px 26px -8px var(--accent-glow, var(--accent)); }
      }

      /* Barra de progreso de scroll (fina, color de marca) */
      #scroll-progress { position: fixed; top: 0; left: 0; height: 2px; width: 0; z-index: 150; background: linear-gradient(90deg, var(--accent), var(--accent-glow, var(--accent))); box-shadow: 0 0 10px -1px var(--accent-glow, var(--accent)); transition: width .12s linear; }
      @media (prefers-reduced-motion: reduce) { #scroll-progress { transition: none; } }

      /* Aura de marca que respira detrás del hero */
      .hero-aurora { position: absolute; inset: -12% -8% auto -8%; height: 62%; z-index: -20; pointer-events: none; opacity: .16; filter: blur(44px); background: radial-gradient(48% 52% at 34% 32%, var(--accent-glow, var(--accent)), transparent 70%); }
      @media (prefers-reduced-motion: no-preference) { .hero-aurora { animation: aurora-drift 16s ease-in-out infinite alternate; } }
      @keyframes aurora-drift { from { transform: translate3d(-3%, -2%, 0) scale(1); } to { transform: translate3d(6%, 3%, 0) scale(1.12); } }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('brand-loader');
        if (!el) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function hide() { el.classList.add('is-hidden'); }
        if (reduce) hide(); else setTimeout(hide, 700);   // flash de marca ~700ms desde el arranque, luego se desvanece
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (a.target === '_blank' || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || (a.hostname && a.hostname !== location.hostname)) return;
          el.classList.remove('is-hidden');
        }, true);
        window.addEventListener('pageshow', function (e) { if (e.persisted) hide(); });
      })();
    </script>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main"
      class="fixed -top-20 left-4 z-[100] inline-flex min-h-11 items-center rounded-md bg-surface px-4 py-2 text-foreground transition-[top] duration-200 focus:top-4"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class={heroOverlay ? '' : 'pt-16'}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal], [data-stagger]');
        if (reduce || !('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      })();
      (function () {
        var bar = document.getElementById('scroll-progress');
        if (!bar) return;
        var ticking = false;
        function update() {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          var pct = max > 0 ? (h.scrollTop || document.body.scrollTop) / max * 100 : 0;
          bar.style.width = pct + '%';
          ticking = false;
        }
        function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      })();
    </script>
  </body>
</html>
