---
import '../styles/global.css';
import { Image } from 'astro:assets';
import crowLoader from '../assets/brand/cuervo-a-guardian.png';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** When true the main content sits under the fixed nav (hero paints behind it). */
  heroOverlay?: boolean;
  /** True on pages that have a Spanish version (the landing); emits hreflang alternates. */
  hasEs?: boolean;
}

const {
  title = 'Hemispheric — Memory for your agent',
  description = 'Free, offline, deterministic memory for your coding agent. No server, no embeddings, no API key. Works where you already work: Claude Code, Codex and more.',
  heroOverlay = false,
  hasEs = false,
} = Astro.props;

const lang = Astro.currentLocale ?? 'en';
const site = (Astro.site?.href ?? 'https://gethemispheric.com/').replace(/\/$/, '');
const basePath = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const enUrl = site + basePath;
const esUrl = site + (basePath === '/' ? '/es/' : '/es' + basePath);
const canonical = site + Astro.url.pathname;
const ogImage = `${site}/og-image.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-crow.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {hasEs && <link rel="alternate" hreflang="en" href={enUrl} />}
    {hasEs && <link rel="alternate" hreflang="es" href={esUrl} />}
    {hasEs && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {/* Anti-flash: apply the saved theme before first paint. Default is dark. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (localStorage.getItem('theme') === 'light') {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body class="bg-background text-foreground">
    <div id="brand-loader" aria-hidden="true" style="position:fixed;inset:0;z-index:200;display:grid;place-items:center;background:var(--background);">
      <div class="bl-inner">
        <Image src={crowLoader} alt="" width={180} height={180} class="bl-crow" loading="eager" />
        <span class="bl-word">Hemispheric<span class="bl-dot">.</span></span>
      </div>
    </div>
    <style is:global>
      #brand-loader { transition: opacity var(--duration-slow, 400ms) var(--ease-out, ease); }
      #brand-loader.is-hidden { opacity: 0; pointer-events: none; }
      #brand-loader .bl-inner { display: grid; justify-items: center; gap: 14px; }
      #brand-loader .bl-crow { width: clamp(84px, 14vw, 150px); height: auto; opacity: .95; }
      #brand-loader .bl-word { font-family: var(--font-display); font-size: clamp(2rem, 6vw, 4rem); color: var(--foreground); letter-spacing: -0.01em; }
      #brand-loader .bl-dot { color: var(--accent); }
      @media (prefers-reduced-motion: reduce) { #brand-loader { transition: none; } }

      /* --- F14: vida (reveals al scroll + float), sin dependencias --- */
      /* Solo con JS (html.js): sin JS el contenido se ve siempre. */
      @media (prefers-reduced-motion: no-preference) {
        html.js [data-reveal] {
          opacity: 0;
          transform: translateY(18px);
          transition: opacity 0.7s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
                      transform 0.7s var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
          transition-delay: var(--reveal-delay, 0ms);
          will-change: opacity, transform;
        }
        html.js [data-reveal].is-visible { opacity: 1; transform: none; }
        /* Flotación muy sutil (cuervo del hero, acentos) */
        [data-float] { animation: hemi-float 7s ease-in-out infinite; }
        @keyframes hemi-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
      }
    </style>
    <script is:inline>
      (function () {
        var el = document.getElementById('brand-loader');
        if (!el) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function hide() { el.classList.add('is-hidden'); }
        if (reduce) hide(); else setTimeout(hide, 700);   // flash de marca ~700ms desde el arranque, luego se desvanece
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (a.target === '_blank' || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || (a.hostname && a.hostname !== location.hostname)) return;
          el.classList.remove('is-hidden');
        }, true);
        window.addEventListener('pageshow', function (e) { if (e.persisted) hide(); });
      })();
    </script>
    <a
      href="#main"
      class="fixed -top-20 left-4 z-[100] inline-flex min-h-11 items-center rounded-md bg-surface px-4 py-2 text-foreground transition-[top] duration-200 focus:top-4"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main" class={heroOverlay ? '' : 'pt-16'}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          for (var i = 0; i < els.length; i++) els[i].classList.add('is-visible');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        for (var j = 0; j < els.length; j++) io.observe(els[j]);
      })();
    </script>
  </body>
</html>
