---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/landing/Hero.astro';
import DemoCortex from '../../components/landing/DemoCortex.astro';
import CortexSlides from '../../components/landing/CortexSlides.astro';
import HowItWorks from '../../components/landing/HowItWorks.astro';
import BenchmarksSummary from '../../components/landing/BenchmarksSummary.astro';
import QuickStart from '../../components/landing/QuickStart.astro';
import OpenSource from '../../components/landing/OpenSource.astro';

const title = 'Corvusmem — Memoria para tu agente';
const description =
  'Memoria determinista, offline y sin dependencias para tu agente de código. Sin servidor, sin embeddings, sin API key. Funciona donde ya trabajas: Claude Code, Codex y más.';
---

<BaseLayout heroOverlay hasEs {title} {description}>
  <Hero />
  <div data-reveal><DemoCortex /></div>
  <div data-reveal><CortexSlides /></div>
  <HowItWorks />
  <div data-reveal><BenchmarksSummary /></div>
  <div data-reveal><QuickStart /></div>
  <div data-reveal><OpenSource /></div>
</BaseLayout>
