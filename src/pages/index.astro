---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="mx-auto flex max-w-3xl flex-col gap-6 px-6 py-24">
    <p class="font-mono text-sm tracking-widest text-accent uppercase">
      Base layout check
    </p>
    <h1 class="font-display text-6xl leading-none">
      Memory for your <em>agent.</em>
    </h1>
    <p class="max-w-prose text-lg text-muted">
      Walking skeleton: fixed nav that darkens on scroll, a theme toggle that
      persists, and a footer. The hero and the rest of the page come next.
    </p>
    <code
      class="w-fit rounded-md bg-code-bg px-3 py-2 font-mono text-sm text-foreground"
    >
      hemispheric install --claude
    </code>
    <div class="h-[120vh]" aria-hidden="true"></div>
    <p class="text-muted">Scroll down to see the nav darken.</p>
  </section>
</BaseLayout>
