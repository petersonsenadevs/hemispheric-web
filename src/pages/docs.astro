---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { Image } from 'astro:assets';
import crowDocs from '../assets/brand/cuervo-b-memoria.png';

// Exact install command still a placeholder (D-008), kept consistent with the rest of the site.
const INSTALL_CMD = 'npx corvusmem install --global';
const CONTACT = 'petersonsena24@gmail.com';

const toc = [
  { id: 'what', label: 'What it is' },
  { id: 'install', label: 'Install' },
  { id: 'use', label: 'Using it' },
  { id: 'migrate', label: 'Migrate' },
  { id: 'how', label: 'How it works' },
  { id: 'memory', label: 'The memory' },
  { id: 'footprint', label: 'Footprint' },
  { id: 'teams', label: 'Teams' },
  { id: 'cortex', label: 'The Cortex' },
  { id: 'hosts', label: 'Hosts' },
  { id: 'license', label: 'License' },
  { id: 'faq', label: 'FAQ' },
];

const faqs = [
  {
    q: 'Does my data ever leave my machine?',
    a: 'No. The memory is a local file you own. No server, no cloud, no API key, no telemetry. Corvusmem runs entirely offline.',
  },
  {
    q: 'How is this different from mem0 or Zep?',
    a: 'Those store your memory in their cloud behind an API. Corvusmem keeps everything local and deterministic — same input, same result, no embeddings or vector database involved.',
  },
  {
    q: 'Do I need an embedding model or a vector DB?',
    a: 'No. Facts are stored in a lightweight local graph and retrieved by name, date and relevance with two-hop activation. No embeddings, no vector database.',
  },
  {
    q: 'Which agents does it work with?',
    a: 'Claude Code and Codex today, plus a standalone CLI. The engine detects its host and adapts; the memory is the same underneath.',
  },
  {
    q: 'What happens with a team on the same project?',
    a: "Shared project facts (stack, decisions) are common to everyone. Personal facts (your preferences, who you are) are kept per author, so two teammates never overwrite each other. The author is read from your git email, with no setup and no network.",
  },
  {
    q: 'Is it free?',
    a: 'Free for personal and non-commercial use under PolyForm Noncommercial. Using it inside a company or a paid product needs a commercial license.',
  },
];

const pageTitle = 'Docs — Corvusmem';
const pageDescription =
  'How Corvusmem works: local, deterministic, offline memory for your coding agent. Install, the Cortex, hosts (Claude Code, Codex), and license.';
---

<BaseLayout title={pageTitle} description={pageDescription} hasEs>
  <!-- Header -->
  <section class="border-b border-border">
    <div class="mx-auto grid max-w-5xl items-center gap-10 px-6 py-20 sm:px-8 lg:grid-cols-[1.4fr_1fr] lg:px-12 lg:py-28">
      <div>
      <p class="font-mono text-xs tracking-wider text-accent uppercase">Documentation</p>
      <h1 class="mt-4 font-display text-5xl leading-[1.05] text-foreground sm:text-6xl">
        A memory your agent keeps.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-muted">
        Corvusmem gives your coding agent a real memory — local, deterministic and offline.
        It hooks into Claude Code and Codex, writes what your agent learns to a file you own, and
        recalls it across sessions and projects. No embeddings, no server, no API key.
      </p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="On this page">
        {
          toc.map((t) => (
            <a
              href={`#${t.id}`}
              class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted transition-colors hover:border-border-strong hover:text-foreground"
            >
              {t.label}
            </a>
          ))
        }
      </nav>
      </div>
      <div class="hidden justify-self-center lg:block">
        <Image
          src={crowDocs}
          alt="The Corvusmem crow, data-art, curled around a stored memory"
          width={420}
          height={420}
          class="w-full max-w-[360px]"
        />
      </div>
    </div>
  </section>

  <!-- What it is -->
  <section id="what" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">What it is</h2>
      <div class="mt-5 max-w-3xl space-y-4 text-lg leading-relaxed text-muted">
        <p>
          Your agent, with a memory of its own — and it never leaves your machine. Agents forget
          everything between sessions; Corvusmem is the memory that remembers you and your
          projects, in a single local file you control.
        </p>
        <p>
          It is <strong class="font-semibold text-foreground">deterministic</strong> (same input,
          same result), <strong class="font-semibold text-foreground">offline</strong> (no network)
          and <strong class="font-semibold text-foreground">zero-dependency</strong>. Unlike
          cloud memories, yours stays yours.
        </p>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section id="install" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Install</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
        One command. No account, no cloud, no API key — the hook writes to a local file you own.
        Choose where the memory lives: just <strong class="font-semibold text-foreground">this project</strong>,
        or <strong class="font-semibold text-foreground">all your projects</strong> at once.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-border bg-surface p-6 min-w-0">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">This project</p>
          <h3 class="mt-2 font-display text-xl text-foreground">Per-project</h3>
          <p class="mt-3 leading-relaxed text-muted">
            For a team repo: hooks register in
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">./.claude/settings.json</code>
            and the project memory in
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.corvusmem/</code>.
            Commit both and teammates get memory the moment they clone.
          </p>
          <div class="mt-4"><CopyCommand cmd="npx corvusmem install" /></div>
        </div>
        <div class="rounded-2xl border border-border bg-surface p-6 min-w-0">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">All projects · recommended</p>
          <h3 class="mt-2 font-display text-xl text-foreground">Global</h3>
          <p class="mt-3 leading-relaxed text-muted">
            The easiest setup: <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--global</code>
            registers the hooks in your home
            (<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">~/.claude/settings.json</code>),
            so every project gets memory. Your personal memory sits in
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">~/.config/corvusmem/</code>,
            and each project's memory still lives in its own <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.corvusmem/</code>.
          </p>
          <div class="mt-4"><CopyCommand cmd="npx corvusmem install --global" /></div>
        </div>
      </div>

      <div class="mt-8 max-w-3xl">
        <p class="font-mono text-sm tracking-widest text-accent uppercase">More options</p>
        <ul class="mt-3 space-y-2 leading-relaxed text-muted">
          <li>
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--codex</code>
            — install for Codex (plugin path); same memory underneath.
          </li>
          <li>
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--dry-run</code>
            — show exactly what it would do, writing nothing.
          </li>
          <li>
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">npx corvusmem uninstall</code>
            — remove the hooks, leaving your memory and everything else intact.
          </li>
        </ul>
      </div>
      <div class="mt-8 max-w-3xl rounded-2xl border border-border bg-surface p-5 min-w-0">
        <p class="leading-relaxed text-muted">
          <strong class="font-semibold text-foreground">The mode only decides where Corvus turns on</strong> — not where
          memory lives. A project's facts always land in that repo's
          <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.corvusmem/</code>,
          with either install — so you never need a per-project install just to keep memory in the repo.
          <strong class="font-semibold text-foreground"> For a team:</strong> commit
          <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.corvusmem/</code>
          (the shared memory) and, with a per-project install,
          <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.claude/settings.json</code>
          so teammates get the hooks the moment they clone. Never commit
          <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">~/.config/corvusmem/</code> — that's your private memory.
        </p>
      </div>
      <p class="mt-6 font-mono text-xs tracking-wide text-subtle">
        Works with Claude Code and Codex · the exact command for your host is shown during setup
      </p>
    </div>
  </section>

  <!-- Using it -->
  <section id="use" class="scroll-mt-20 border-b border-border bg-surface">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Using it</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
        After installing, your agent captures and recalls memory on its own — you don't do a thing.
        When you want to <strong class="font-semibold text-foreground">look at it</strong> or
        <strong class="font-semibold text-foreground">steer it</strong>, these commands work from any project:
      </p>

      <div class="mt-8 max-w-3xl space-y-7">
        <div>
          <h3 class="font-display text-xl text-foreground">See your memory — the Cortex</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Draws your whole memory as a local HTML brain and prints the path. Open it in your browser — it works offline.
          </p>
          <div class="mt-3"><CopyCommand cmd="npx corvusmem --cortex" /></div>
        </div>

        <div>
          <h3 class="font-display text-xl text-foreground">Ask what it already knows</h3>
          <p class="mt-2 leading-relaxed text-muted">The same recall your agent gets, from the terminal.</p>
          <div class="mt-3"><CopyCommand cmd='npx corvusmem --recall "stripe webhook"' /></div>
        </div>

        <div>
          <h3 class="font-display text-xl text-foreground">List everything, or forget one fact</h3>
          <div class="mt-3 space-y-2">
            <CopyCommand cmd="npx corvusmem --list" />
            <CopyCommand cmd="npx corvusmem --forget <id>" />
          </div>
        </div>

        <div>
          <h3 class="font-display text-xl text-foreground">Add a fact yourself</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Rarely needed — the agent does it — but you can. Use
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--scope user</code>
            to store it in your personal memory instead of the project.
          </p>
          <div class="mt-3"><CopyCommand cmd='npx corvusmem --save --dimension project.stack --value "Astro + Tailwind" --scope project' /></div>
        </div>
      </div>

      <p class="mt-7 max-w-3xl leading-relaxed text-muted">
        Flags are English with Spanish aliases
        (<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--save</code>/<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--guardar</code>,
        <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--recall</code>/<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--recordar</code>).
        Keys and values work in any language — the memory is language-agnostic.
      </p>
    </div>
  </section>

  <!-- Migrate existing memory -->
  <section id="migrate" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Already have notes? Bring them in</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
        If your project already carries memory — a <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">CLAUDE.md</code>,
        an <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">AGENTS.md</code>, Cursor or Copilot
        rules, or plain notes in <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">docs/</code> —
        you don't start over. Corvus finds them and absorbs what matters, so a teammate adopting it keeps everything already written.
      </p>

      <div class="mt-8 max-w-3xl space-y-7">
        <div>
          <h3 class="font-display text-xl text-foreground">1 · See what's there</h3>
          <p class="mt-2 leading-relaxed text-muted">
            A deterministic, read-only scan. It lists the known agent-memory files and any other markdown in
            subfolders that might hold memory, leaving boilerplate (README, CHANGELOG, LICENSE) out.
          </p>
          <div class="mt-3"><CopyCommand cmd="npx corvusmem import" /></div>
        </div>
        <div>
          <h3 class="font-display text-xl text-foreground">2 · Absorb it</h3>
          <p class="mt-2 leading-relaxed text-muted">
            Inside Claude Code, run the command below. Your agent reads what the scan found, decides what is
            durable memory, asks you — in your own language — about anything unclear, and saves it. Your original
            files are left untouched.
          </p>
          <div class="mt-3"><CopyCommand cmd="/corvus-absorb" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">How it works</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        <div>
          <p class="font-mono text-sm tracking-widest text-accent uppercase">Capture</p>
          <h3 class="mt-2 font-display text-xl text-foreground">The hook listens</h3>
          <p class="mt-3 leading-relaxed text-muted">
            A <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">PostToolUse</code>
            hook reads each exchange and extracts facts — decisions, file paths, project context.
          </p>
        </div>
        <div>
          <p class="font-mono text-sm tracking-widest text-accent uppercase">Store</p>
          <h3 class="mt-2 font-display text-xl text-foreground">Facts, not vectors</h3>
          <p class="mt-3 leading-relaxed text-muted">
            Each fact lands in a lightweight local graph with its name, date and links. The whole
            Cortex is a single file you own.
          </p>
        </div>
        <div>
          <p class="font-mono text-sm tracking-widest text-accent uppercase">Retrieve</p>
          <h3 class="mt-2 font-display text-xl text-foreground">Two-hop activation</h3>
          <p class="mt-3 leading-relaxed text-muted">
            A query activates the matching node and spreads one hop out, surfacing related facts —
            no semantic search, no embedding model. Instant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The memory -->
  <section id="memory" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">The memory</h2>
      <div class="mt-5 max-w-3xl space-y-4 text-lg leading-relaxed text-muted">
        <p>
          Think of it as a notebook your agent keeps for you — but it only writes down what is
          <strong class="font-semibold text-foreground">stable</strong>: decisions, the project's stack, who you are,
          your preferences, your goals. Passing chatter is ignored. When something changes, the new value
          <strong class="font-semibold text-foreground">replaces</strong> the old one and the old one is kept, dated, in
          the history — so your agent is never working from something you already changed.
        </p>
        <p>There are two kinds of memory, and they never get mixed up:</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-border bg-surface p-6 min-w-0">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">Project</p>
          <h3 class="mt-2 font-display text-xl text-foreground">About the project</h3>
          <p class="mt-3 leading-relaxed text-muted">
            The stack, the client, decisions, deadlines. It lives in the project folder (<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">.corvusmem/</code>),
            so your team — and Codex — share it. "The stack is Next" is true no matter who said it.
          </p>
        </div>
        <div class="rounded-2xl border border-border bg-surface p-6 min-w-0">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">You</p>
          <h3 class="mt-2 font-display text-xl text-foreground">About you</h3>
          <p class="mt-3 leading-relaxed text-muted">
            Who you are and how you like to work — carried across every project. It lives on your machine
            (<code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">~/.config/corvusmem/</code>),
            private to you, never committed. Your agent recalls both at once.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footprint -->
  <section id="footprint" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Footprint</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
        The memory barely touches your agent's context window — and it never grows. A hard cap of five facts per
        message keeps the footprint <strong class="font-semibold text-foreground">flat</strong>: about 413 tokens
        per message (median) whether you've stored 10 facts or 10,000. O(1), not O(n). And
        <strong class="font-semibold text-foreground">zero</strong> API tokens — no embeddings, no network.
      </p>
      <a
        href="/benchmarks#footprint"
        class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent transition-opacity hover:opacity-80"
      >
        See the footprint benchmark
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Teams -->
  <section id="teams" class="scroll-mt-20 border-b border-border bg-surface">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Teams — one project, many people</h2>
      <div class="mt-5 max-w-3xl space-y-4 text-lg leading-relaxed text-muted">
        <p>
          When several people work on the same project, the shared memory keeps each person's
          <strong class="font-semibold text-foreground">personal</strong> facts separate. If Ana prefers Vim and Bob
          prefers Emacs, both are kept — one never overwrites the other. Facts that describe the
          <strong class="font-semibold text-foreground">project itself</strong> (stack, decisions) stay shared and have
          no owner, exactly as they should.
        </p>
        <p>
          You don't configure anything: Corvusmem reads the author from your <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">git</code>
          email (or your system user), with no network. For a solo developer it's invisible — it just works.
        </p>
      </div>
    </div>
  </section>

  <!-- The Cortex -->
  <section id="cortex" class="scroll-mt-20 border-b border-border bg-surface">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">The Cortex</h2>
      <div class="mt-5 max-w-3xl space-y-4 text-lg leading-relaxed text-muted">
        <p>
          The Cortex draws everything your agent knows as a living brain of points — one glow per
          fact. Each kind of memory settles in its own zone: decisions, goals, project facts, who
          you are, what was lived.
        </p>
        <p>
          Search a fact and only its node and connections light up, like a neuron firing. It is not
          a picture — it is a readout of the memory your agent actually uses.
        </p>
      </div>
      <div class="mt-8 max-w-xl">
        <p class="text-base leading-relaxed text-muted">
          Open your own Cortex from any project folder — no extra setup:
        </p>
        <div class="mt-3">
          <CopyCommand cmd="npx corvusmem --cortex" />
        </div>
        <p class="mt-3 font-mono text-xs tracking-wide text-subtle">
          It writes a self-contained HTML file (offline, no network) and prints the path — open it in your browser.
        </p>
        <ul class="mt-4 space-y-2 leading-relaxed text-muted">
          <li>
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--client</code>
            — a shareable view with nothing private in it, to show a client or teammate.
          </li>
          <li>
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--output &lt;dir&gt;</code>
            — write the HTML somewhere else;
            <code class="rounded bg-code-bg px-1.5 py-0.5 font-mono text-sm text-foreground">--lang en|es|…</code>
            — pick the language.
          </li>
        </ul>
      </div>
      <a
        href="/#demo"
        class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent transition-opacity hover:opacity-80"
      >
        See the live Cortex
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- Hosts -->
  <section id="hosts" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">Hosts</h2>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">
        The engine detects where it runs and adapts; the memory is the same underneath.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          [
            { h: 'Claude Code', d: 'Hooks register in your project settings; facts captured after every tool call.' },
            { h: 'Codex', d: 'Runs through the plugin path; the same brain, the same local file.' },
            { h: 'Standalone', d: 'A plain CLI for any project — read, write and search the memory directly.' },
          ].map((x) => (
            <div class="rounded-2xl border border-border bg-surface p-6 min-w-0">
              <h3 class="font-display text-xl text-foreground">{x.h}</h3>
              <p class="mt-2 leading-relaxed text-muted">{x.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- License -->
  <section id="license" class="scroll-mt-20 border-b border-border">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">License</h2>
      <div class="mt-5 max-w-3xl space-y-4 text-lg leading-relaxed text-muted">
        <p>
          Free for personal and non-commercial use under
          <strong class="font-semibold text-foreground">PolyForm Noncommercial</strong>. Zero
          telemetry — your memory lives in local files you own.
        </p>
        <p>
          Using Corvusmem inside a company or a paid product needs a commercial license.
        </p>
      </div>
      <a
        href={`mailto:${CONTACT}?subject=Corvusmem%20commercial%20license`}
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-6 text-sm font-semibold text-foreground transition-colors hover:bg-surface-raised"
      >
        Get a commercial license
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-20">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:px-8 lg:px-12" data-reveal>
      <h2 class="font-display text-3xl text-foreground sm:text-4xl">FAQ</h2>
      <div class="mt-8 max-w-3xl divide-y divide-border border-y border-border">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-lg text-foreground marker:content-none">
                {f.q}
                <span class="text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
