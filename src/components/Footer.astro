---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-[1400px] flex-col gap-4 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12"
  >
    <div class="flex flex-col gap-1">
      <span class="font-display text-lg leading-none text-foreground">
        Hemispheric<span class="text-accent">.</span>
      </span>
      <span class="font-mono text-xs text-subtle">
        PolyForm Noncommercial · © {year} Peterson Sena
      </span>
    </div>
    <nav class="flex gap-1" aria-label="Footer">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex min-h-11 items-center rounded-md px-3 text-sm text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
