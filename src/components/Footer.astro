---
// Licencia real (devlog 207): PolyForm Noncommercial + comercial de pago, (C) 2026 Peterson Sena.
import { Image } from 'astro:assets';
import crowMark from '../assets/brand/favicon-cuervo.png';
import { getLang, useTranslations } from '../i18n/utils';
const CONTACT = 'petersonsena24@gmail.com';
const year = new Date().getFullYear();
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Enlaces reales del autor y del producto
const REPO = 'https://github.com/petersonsenadevs/Hemispheric-claude-codex';
const NPM = 'https://www.npmjs.com/package/hemispheric';
const LINKEDIN = 'https://www.linkedin.com/in/peterson-sena/';
const GITHUB = 'https://github.com/petersonsenadevs';
const COFFEE = 'https://buymeacoffee.com/petersonsena';

const links = [
  { label: t('footer.docs'), href: '/docs' },
  { label: t('footer.benchmarks'), href: '/benchmarks' },
  { label: t('footer.commercial'), href: `mailto:${CONTACT}?subject=Hemispheric%20commercial%20license` },
];

const resources = [
  { label: 'GitHub', href: REPO },
  { label: 'npm', href: NPM },
  { label: 'LinkedIn', href: LINKEDIN },
  { label: 'Buy me a coffee', href: COFFEE },
];
---

<footer class="border-t border-border">
  <div
    class="mx-auto flex max-w-[1600px] flex-col gap-4 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12"
  >
    <div class="flex items-center gap-3">
      <Image src={crowMark} alt="" width={40} height={40} class="size-10" />
      <div class="flex flex-col gap-1">
        <span class="font-display text-lg leading-none text-foreground">
          Hemispheric<span class="text-accent">.</span>
        </span>
        <span class="font-mono text-xs text-subtle">
          PolyForm Noncommercial · © {year}{' '}
          <a
            href={GITHUB}
            target="_blank"
            rel="noopener"
            class="text-subtle underline decoration-dotted underline-offset-2 transition-colors hover:text-foreground"
          >Peterson Sena</a>
        </span>
      </div>
    </div>
    <nav class="flex gap-1" aria-label="Footer">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex min-h-11 items-center rounded-md px-3 text-sm text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-5 gap-y-2 px-6 py-5 sm:px-8 lg:px-12">
      {
        resources.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-1.5 font-mono text-xs tracking-wide text-muted transition-colors hover:text-foreground"
          >
            <span class="relative">
              {r.label}
              <span class="absolute inset-x-0 -bottom-0.5 h-px origin-left scale-x-0 bg-accent transition-transform duration-300 group-hover:scale-x-100" />
            </span>
            <svg class="size-3 opacity-50 transition-opacity group-hover:opacity-100" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3h7v7M13 3 4 12" />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</footer>
