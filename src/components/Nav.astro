---
import ThemeToggle from './ThemeToggle.astro';

// GitHub repo URL is still a placeholder (risk logged in PLAN.md). Wire the real
// one before launch.
const REPO_URL = '#';

const links = [
  { label: 'Demo', href: '/#demo' },
  { label: 'Benchmarks', href: '/benchmarks' },
  { label: 'Docs', href: '/docs' },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 h-16 transition-colors duration-300"
>
  <nav class="mx-auto flex h-full max-w-6xl items-center justify-between px-6">
    <a
      href="/"
      class="flex h-full items-center font-display text-xl leading-none text-foreground"
      aria-label="Hemispheric, home"
    >
      Hemispheric<span class="text-accent">.</span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex min-h-11 items-center rounded-md px-3 text-sm text-muted transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={REPO_URL}
        class="grid size-11 place-items-center rounded-md text-muted transition-colors hover:text-foreground"
        aria-label="GitHub repository"
      >
        <svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>

    <!-- Mobile controls -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        id="nav-burger"
        type="button"
        class="grid size-11 place-items-center rounded-md text-foreground"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg class="icon-open size-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="icon-close size-6" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="nav-mobile"
    class="hidden border-b border-border bg-surface px-6 py-4 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="flex min-h-11 items-center rounded-md px-3 text-base text-foreground transition-colors hover:bg-surface-raised"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={REPO_URL}
          class="flex min-h-11 items-center rounded-md px-3 text-base text-foreground transition-colors hover:bg-surface-raised"
        >
          GitHub
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  /* Transparent over the hero; darkens with a blur once scrolled. */
  #site-nav.scrolled {
    background-color: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  #nav-burger .icon-close {
    display: none;
  }
  #nav-burger[aria-expanded='true'] .icon-open {
    display: none;
  }
  #nav-burger[aria-expanded='true'] .icon-close {
    display: block;
  }
</style>

<script>
  // Darken the nav once the page is scrolled.
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('scrolled', window.scrollY > 10);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu toggle.
  const burger = document.getElementById('nav-burger');
  const panel = document.getElementById('nav-mobile');
  const setOpen = (open: boolean) => {
    if (!burger || !panel) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.classList.toggle('hidden', !open);
  };
  burger?.addEventListener('click', () => {
    setOpen(burger.getAttribute('aria-expanded') !== 'true');
  });
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
