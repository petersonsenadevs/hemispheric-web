---
// "Meet the Cortex": slides horizontales que explican el cerebro (F12-T8). Sin dependencias: scroll-snap + un poco
// de JS para botones, puntos, teclado y estado activo. Respeta prefers-reduced-motion. Tokens del design system. i18n.
import { getLang, useTranslations } from '../../i18n/utils';
const t = useTranslations(getLang(Astro.currentLocale));
const slides = [1, 2, 3, 4, 5].map((n) => ({
  eyebrow: t(`cortex.s${n}.eyebrow` as any),
  title: t(`cortex.s${n}.title` as any),
  body: t(`cortex.s${n}.body` as any),
  accent: '0' + n,
}));
---

<section id="cortex" class="scroll-mt-16 border-t border-border">
  <div class="mx-auto max-w-[1600px] px-6 py-24 sm:px-8 lg:px-12">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <p class="mb-3 font-mono text-sm tracking-widest text-accent uppercase">{t('cortex.eyebrow')}</p>
      <h2 class="font-display text-4xl leading-tight text-foreground sm:text-5xl">
        {t('cortex.title')}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        {t('cortex.body')}
      </p>
    </header>

    <div
      class="cx-carousel relative"
      role="region"
      aria-roledescription="carousel"
      aria-label={t('cortex.eyebrow')}
    >
      <ul class="cx-track flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4" tabindex="0">
        {
          slides.map((s, i) => (
            <li
              class="cx-slide min-w-[82%] snap-start sm:min-w-[440px] lg:min-w-[520px]"
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${slides.length}`}
            >
              <article class="flex h-full flex-col rounded-2xl border border-border bg-surface p-8 lg:p-10">
                <div class="mb-6 flex items-center justify-between">
                  <span class="font-mono text-xs tracking-widest text-accent uppercase">{s.eyebrow}</span>
                  <span class="font-mono text-sm text-subtle">{s.accent}</span>
                </div>
                <h3 class="mb-4 font-display text-2xl leading-tight text-foreground sm:text-3xl">{s.title}</h3>
                <p class="leading-relaxed text-muted">{s.body}</p>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 flex items-center justify-between gap-4">
        <div class="cx-dots flex gap-2" role="tablist" aria-label={t('cortex.dot')}>
          {
            slides.map((_, i) => (
              <button
                type="button"
                class="cx-dot size-2.5 rounded-full border border-border-strong transition-colors"
                data-i={i}
                role="tab"
                aria-label={`${t('cortex.dot')} ${i + 1}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))
          }
        </div>
        <div class="flex gap-2">
          <button
            type="button"
            class="cx-prev grid size-11 place-items-center rounded-md border border-border-strong text-foreground transition-colors hover:bg-surface-raised disabled:opacity-40"
            aria-label={t('cortex.prev')}
          >
            <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 3L5 8l5 5" />
            </svg>
          </button>
          <button
            type="button"
            class="cx-next grid size-11 place-items-center rounded-md border border-border-strong text-foreground transition-colors hover:bg-surface-raised disabled:opacity-40"
            aria-label={t('cortex.next')}
          >
            <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3l5 5-5 5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cx-track {
    scrollbar-width: none;
  }
  .cx-track::-webkit-scrollbar {
    display: none;
  }
  .cx-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 12px;
  }
  .cx-dot[aria-selected='true'] {
    background-color: var(--accent);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('.cx-carousel').forEach((root) => {
    const track = root.querySelector('.cx-track') as HTMLElement | null;
    const slides = Array.from(root.querySelectorAll('.cx-slide')) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll('.cx-dot')) as HTMLElement[];
    const prev = root.querySelector('.cx-prev') as HTMLButtonElement | null;
    const next = root.querySelector('.cx-next') as HTMLButtonElement | null;
    if (!track || !slides.length) return;

    let current = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const goTo = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      slides[n].scrollIntoView({
        behavior: reduce ? 'auto' : 'smooth',
        inline: 'start',
        block: 'nearest',
      });
    };

    const setActive = (i: number) => {
      current = i;
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    // Which slide is most in view → active dot.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio > 0.6) {
            setActive(slides.indexOf(e.target as HTMLElement));
          }
        });
      },
      { root: track, threshold: [0.6] }
    );
    slides.forEach((s) => io.observe(s));

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(current + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(current - 1);
      }
    });

    setActive(0);
  });
</script>
