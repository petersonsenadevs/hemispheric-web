---
import { Image } from 'astro:assets';
import crowBg from '../../assets/brand/cuervo-a-guardian.png';
import CortexEmbed from './CortexEmbed.astro';
import CopyCommand from '../CopyCommand.astro';
import { getLang, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
// Install command shown in the hero. Exact command is still a placeholder (D-008).
const INSTALL_CMD = 'npx hemispheric install --claude';
---

<section
  class="relative isolate mx-auto grid min-h-screen max-w-[1600px] items-center gap-12 overflow-hidden px-6 pt-28 pb-16 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:px-12 lg:pt-16"
>
  <div class="hero-aurora"></div>
  <Image
    src={crowBg}
    alt=""
    width={820}
    height={820}
    aria-hidden="true"
    data-float
    class="pointer-events-none absolute inset-y-0 left-0 -z-10 w-[min(52vw,520px)] object-contain object-center opacity-[0.14] select-none"
  />
  <div class="flex flex-col items-start">
    <p class="mb-7 font-mono text-xs tracking-[0.12em] text-accent uppercase" data-reveal style="--reveal-delay:80ms">
      {t('hero.eyebrow')}
    </p>

    <h1
      class="mb-6 font-display text-5xl leading-[1.06] tracking-tight text-foreground sm:text-6xl lg:text-7xl"
      data-reveal style="--reveal-delay:180ms"
    >
      {t('hero.title.a')}<br />{t('hero.title.b')} <em class="text-muted italic">{t('hero.title.em')}</em>
    </h1>

    <p class="mb-10 max-w-[44ch] text-lg leading-relaxed text-muted" data-reveal style="--reveal-delay:300ms">
      {t('hero.body')}
    </p>

    <div class="flex flex-col items-start gap-4" data-reveal style="--reveal-delay:420ms">
      <a
        href="#install"
        class="inline-flex min-h-11 items-center gap-2.5 rounded-md bg-accent px-6 font-sans text-sm font-semibold text-on-accent transition-[opacity,transform] hover:-translate-y-px hover:opacity-90"
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 2v9M4 7l4 4 4-4"></path>
          <line x1="2" y1="14" x2="14" y2="14"></line>
        </svg>
        {t('hero.install')}
      </a>

      <CopyCommand cmd={INSTALL_CMD} />

      <a
        href="#demo"
        class="inline-flex min-h-11 items-center text-sm text-muted transition-colors hover:text-foreground"
      >
        {t('hero.demo')}
      </a>
    </div>
  </div>

  <div data-reveal style="--reveal-delay:360ms">
    <CortexEmbed
      src="/cortex-hero.html"
      title="The Cortex — your agent's memory as a living brain"
      bare
      frameClass="block h-[360px] w-full border-0 sm:h-[460px] lg:h-[560px]"
    />
  </div>
</section>
