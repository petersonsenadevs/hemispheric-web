---
import CopyCommand from '../CopyCommand.astro';
import { getLang, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
// Native plugin first (Claude Code / Codex). npx is the fallback for agents without plugins.
const CLAUDE_MKT = '/plugin marketplace add petersonsenadevs/corvusmem';
const CLAUDE_INSTALL = '/plugin install corvusmem@corvusmem';
const NPX_CMD = 'npx corvusmem install --global';
// Obsidian retirado: descartado como anfitrion (no prometer lo que no hay).
const hosts = ['Claude Code', 'Codex', 'Standalone'];
---

<section id="install" class="scroll-mt-16">
  <div class="mx-auto max-w-[1600px] px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <h2 class="font-display text-4xl leading-tight text-foreground sm:text-5xl">
        {t('quick.title')}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        {t('quick.body')}
      </p>

      <div class="mt-8 w-full max-w-xl space-y-5 text-left">
        {/* 1 — Claude Code: the native plugin, front and center */}
        <div class="rounded-lg border border-accent/40 bg-accent/[0.04] p-5">
          <p class="flex items-center gap-2 font-mono text-xs tracking-widest text-accent uppercase">
            {t('quick.claudeLabel')}
            <span class="rounded-full bg-accent px-2 py-0.5 text-[0.65rem] font-semibold tracking-normal text-on-accent normal-case">
              {t('quick.claudeTag')}
            </span>
          </p>
          <div class="mt-3 space-y-2">
            <CopyCommand cmd={CLAUDE_MKT} />
            <CopyCommand cmd={CLAUDE_INSTALL} />
          </div>
        </div>

        {/* 2 — Codex: the same plugin */}
        <div class="rounded-lg border border-border p-5">
          <p class="font-mono text-xs tracking-widest text-accent uppercase">{t('quick.codexLabel')}</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{t('quick.codexNote')}</p>
          <div class="mt-3">
            <CopyCommand cmd={CLAUDE_MKT} />
          </div>
        </div>

        {/* 3 — npx: third plane, de-emphasized */}
        <div class="pt-1 opacity-75 transition-opacity hover:opacity-100">
          <p class="font-mono text-[0.7rem] tracking-widest text-subtle uppercase">{t('quick.npxLabel')}</p>
          <div class="mt-2">
            <CopyCommand cmd={NPX_CMD} class="border-dashed text-muted" />
          </div>
          <p class="mt-2 text-xs leading-relaxed text-subtle">{t('quick.npxNote')}</p>
        </div>
      </div>

      <ul class="mt-8 flex flex-wrap justify-center gap-2" aria-label="Supported hosts" data-stagger>
        {
          hosts.map((host) => (
            <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">
              {host}
            </li>
          ))
        }
      </ul>

      <a
        href="/docs"
        class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent transition-opacity hover:opacity-80"
      >
        {t('quick.docs')}
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
