---
// Static placeholder for the Cortex graph. Replaced by the interactive React
// island in F3. Colors use --cortex-* tokens so it adapts to light mode;
// animation delays are classes (no inline style, per conventions).
---

<div class="flex items-center justify-center">
  <svg
    class="cortex-svg h-auto w-full max-w-[420px] overflow-visible"
    viewBox="0 0 420 360"
    fill="none"
    role="img"
    aria-label="Cortex memory graph: a central active node connected to project, stack, memory, date and framework nodes"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="cortex-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="5" result="blur"></feGaussianBlur>
        <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
      </filter>
    </defs>

    <!-- Edges -->
    <g stroke="var(--cortex-edge)" stroke-width="1">
      <line x1="210" y1="175" x2="90" y2="100"></line>
      <line x1="210" y1="175" x2="340" y2="95"></line>
      <line x1="210" y1="175" x2="75" y2="255"></line>
      <line x1="210" y1="175" x2="345" y2="265"></line>
      <line x1="210" y1="175" x2="210" y2="320"></line>
      <line x1="90" y1="100" x2="75" y2="255"></line>
      <line x1="340" y1="95" x2="345" y2="265"></line>
    </g>

    <!-- Active edges from the central node -->
    <line class="edge-active" x1="210" y1="175" x2="90" y2="100" stroke="var(--cortex-edge-active)" stroke-width="1.5"></line>
    <line class="edge-active d2" x1="210" y1="175" x2="340" y2="95" stroke="var(--cortex-edge-active)" stroke-width="1.5"></line>

    <!-- Inactive nodes -->
    <g class="node node-inactive d1" transform="translate(90,100)">
      <circle r="22" fill="var(--surface)" stroke="var(--cortex-edge)" stroke-width="1"></circle>
      <circle r="7" fill="var(--cortex-node)" opacity="0.75"></circle>
      <text x="0" y="36" text-anchor="middle" class="cortex-label">project</text>
    </g>
    <g class="node node-inactive d2" transform="translate(340,95)">
      <circle r="22" fill="var(--surface)" stroke="var(--cortex-edge)" stroke-width="1"></circle>
      <circle r="7" fill="var(--cortex-node)" opacity="0.75"></circle>
      <text x="0" y="36" text-anchor="middle" class="cortex-label">stack</text>
    </g>
    <g class="node node-inactive d3" transform="translate(75,255)">
      <circle r="22" fill="var(--surface)" stroke="var(--cortex-edge)" stroke-width="1"></circle>
      <circle r="7" fill="var(--cortex-node)" opacity="0.75"></circle>
      <text x="0" y="36" text-anchor="middle" class="cortex-label">memory</text>
    </g>
    <g class="node node-inactive d4" transform="translate(345,265)">
      <circle r="22" fill="var(--surface)" stroke="var(--cortex-edge)" stroke-width="1"></circle>
      <circle r="7" fill="var(--cortex-node)" opacity="0.75"></circle>
      <text x="0" y="36" text-anchor="middle" class="cortex-label">astro</text>
    </g>
    <g class="node node-inactive d5" transform="translate(210,320)">
      <circle r="18" fill="var(--surface)" stroke="var(--cortex-edge)" stroke-width="1"></circle>
      <circle r="5" fill="var(--cortex-node)" opacity="0.55"></circle>
      <text x="0" y="30" text-anchor="middle" class="cortex-label cortex-label-dim">date</text>
    </g>

    <!-- Active (central) node. Position on the outer <g>, animation on the inner
         one, so the CSS scale animation doesn't override the translate. -->
    <g transform="translate(210,175)">
      <g class="node-active">
        <circle class="node-glow" r="32" fill="var(--cortex-glow)"></circle>
        <circle r="24" fill="var(--surface-raised)" stroke="var(--cortex-node-active)" stroke-width="1.5" filter="url(#cortex-glow)"></circle>
        <circle r="9" fill="var(--cortex-node-active)"></circle>
        <text x="0" y="40" text-anchor="middle" class="cortex-label cortex-label-active">claude</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .cortex-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    fill: var(--muted);
  }
  .cortex-label-dim { fill: var(--subtle); }
  .cortex-label-active { fill: var(--cortex-node-active); font-weight: 600; letter-spacing: 0.06em; }

  .node { transform-box: fill-box; transform-origin: center; }

  @keyframes cortex-breathe {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
  }
  @keyframes cortex-breathe-active {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  @keyframes cortex-glow-fade {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.45; }
  }
  @keyframes cortex-edge-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
  }

  .node-inactive { animation: cortex-breathe 3.4s ease-in-out infinite; }
  .node-active {
    transform-box: fill-box;
    transform-origin: center;
    animation: cortex-breathe-active 3s ease-in-out infinite;
  }
  .node-glow { animation: cortex-glow-fade 3s ease-in-out infinite; }
  .edge-active { animation: cortex-edge-pulse 3s ease-in-out infinite; opacity: 0.3; }

  .d1 { animation-delay: 0.4s; }
  .d2 { animation-delay: 0.9s; }
  .d3 { animation-delay: 1.4s; }
  .d4 { animation-delay: 1.9s; }
  .d5 { animation-delay: 2.4s; }
</style>
