---
import Cortex from '../cortex/Cortex.tsx';
---

<section id="demo" class="scroll-mt-16 border-y border-border bg-surface">
  <div class="mx-auto max-w-[1600px] px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <h2 class="font-display text-4xl leading-tight text-foreground sm:text-5xl">
        How it stores and recalls what matters.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Every fact your agent saves is a node. The engine links them by name,
        date and relevance, and recalls them with two-hop activation — no
        embeddings, no server, instant.
      </p>
    </div>
    <Cortex client:visible />
  </div>
</section>
