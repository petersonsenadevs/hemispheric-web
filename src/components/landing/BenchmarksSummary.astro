---
// Condensed benchmarks for the landing. Full table + methodology live on /benchmarks (D-013).
// Numbers are real (LoCoMo, 1,986 questions, Qwen3-8B local). Zep still running (F8-T9).
import { getLang, useTranslations, localizedPath } from '../../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const rows = [
  { engine: 'Corvusmem', overall: '25.6%', note: t('bench.note.hemi'), highlight: true },
  { engine: 'Embedding e5', overall: '28.0%', note: t('bench.note.e5'), highlight: false },
  { engine: 'mem0', overall: '21.1%', note: t('bench.note.mem0'), highlight: false },
  { engine: 'Zep / Graphiti', overall: t('bench.running'), overallPending: true, note: t('bench.note.mem0'), highlight: false },
];
---

<section id="benchmarks" class="scroll-mt-16 border-y border-border bg-surface">
  <div class="mx-auto max-w-[1600px] px-6 py-24 sm:px-8 lg:px-12">
    <header class="mx-auto mb-12 max-w-3xl text-center">
      <h2 class="font-display text-4xl leading-tight text-foreground sm:text-5xl">
        {t('bench.title')}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        {t('bench.body')}
      </p>
    </header>

    <div class="mx-auto max-w-3xl">
      <p class="mb-3 font-mono text-xs tracking-wider text-subtle uppercase">
        {t('bench.dataset')}
      </p>
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-border">
            <th scope="col" class="py-3 text-sm font-medium text-muted">{t('bench.th.engine')}</th>
            <th scope="col" class="py-3 text-right text-sm font-medium text-muted">{t('bench.th.overall')}</th>
            <th scope="col" class="hidden py-3 pl-6 text-sm font-medium text-muted sm:table-cell">{t('bench.th.notes')}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-border/60">
                <td class="py-4 text-foreground">
                  {row.highlight ? <strong class="font-semibold">{row.engine}</strong> : row.engine}
                </td>
                <td class="py-4 text-right font-mono tabular-nums">
                  {
                    row.overallPending ? (
                      <span class="text-sm text-subtle italic">{row.overall}</span>
                    ) : (
                      <span class={row.highlight ? 'text-lg text-accent' : 'text-lg text-foreground'}>
                        {row.overall}
                      </span>
                    )
                  }
                </td>
                <td class="hidden py-4 pl-6 text-sm text-subtle sm:table-cell">{row.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <!-- Temporal highlight -->
      <div class="mt-10 rounded-lg border border-accent/30 bg-background p-6">
        <p class="mb-4 font-mono text-xs tracking-wider text-accent uppercase">
          {t('bench.temporal')}
        </p>
        <div class="flex flex-wrap items-end gap-x-10 gap-y-4">
          <div>
            <p class="font-mono text-3xl tabular-nums text-accent">16.2%</p>
            <p class="mt-1 text-sm text-muted">Corvusmem</p>
          </div>
          <div>
            <p class="font-mono text-3xl tabular-nums text-foreground">5.3%</p>
            <p class="mt-1 text-sm text-muted">mem0</p>
          </div>
          <p class="font-mono text-sm font-semibold text-accent">+206% vs mem0</p>
        </div>
      </div>

      <p class="mt-8 leading-relaxed text-muted">
        {t('bench.temporal.body')}
      </p>

      <a
        href="/benchmarks"
        class="mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent transition-opacity hover:opacity-80"
      >
        {t('bench.full')}
        <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
