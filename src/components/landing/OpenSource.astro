---
// Licencia real (decidida, devlog 207): doble licencia (C) 2026 Peterson Sena.
// Uso personal/no comercial GRATIS bajo PolyForm Noncommercial 1.0.0; uso comercial = licencia de pago.
// REPO_URL sigue sin repo publico: el boton de GitHub solo se muestra si algun dia hay URL real.
const REPO_URL = '#';
const CONTACT = 'petersonsena24@gmail.com';
const badges = ['PolyForm Noncommercial', 'Commercial license available', 'v0.x · early'];
---

<section class="scroll-mt-16 border-t border-border bg-surface">
  <div class="mx-auto max-w-[1400px] px-6 py-24 sm:px-8 lg:px-12">
    <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
      <h2 class="font-display text-4xl leading-tight text-foreground sm:text-5xl">
        Free for you. Fair for everyone.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Free for personal and non-commercial use under PolyForm Noncommercial.
        Using it inside a company or a paid product needs a commercial license.
        Zero telemetry — your memory lives in local files you own.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        {
          badges.map((b) => (
            <span class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">
              {b}
            </span>
          ))
        }
      </div>

      <a
        href={`mailto:${CONTACT}?subject=Hemispheric%20commercial%20license`}
        class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-md border border-border-strong px-6 text-sm font-semibold text-foreground transition-colors hover:bg-surface-raised"
      >
        Get a commercial license
      </a>

      {
        REPO_URL !== '#' && (
          <a
            href={REPO_URL}
            class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-md px-6 text-sm font-semibold text-muted transition-colors hover:text-foreground"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.48 0-.24-.01-.87-.01-1.7-2.78.62-3.37-1.37-3.37-1.37-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.48A10.03 10.03 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"></path>
            </svg>
            View the code
          </a>
        )
      }
    </div>
  </div>
</section>
