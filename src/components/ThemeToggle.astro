---
// Theme toggle: flips html.light and persists to localStorage. No React island
// needed — it's a class + storage toggle. Anti-flash lives in BaseLayout <head>.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch to light theme"
  aria-pressed="false"
  class="grid size-11 place-items-center rounded-md text-foreground transition-colors hover:bg-surface-raised"
>
  <svg
    class="icon-sun size-5"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    class="icon-moon size-5"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  .icon-moon {
    display: none;
  }
  :global(html.light) .icon-sun {
    display: none;
  }
  :global(html.light) .icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    const sync = () => {
      const isLight = document.documentElement.classList.contains('light');
      btn.setAttribute('aria-pressed', String(isLight));
      btn.setAttribute('aria-label', isLight ? 'Switch to dark theme' : 'Switch to light theme');
    };
    sync();
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.classList.toggle('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      sync();
    });
  }
</script>
