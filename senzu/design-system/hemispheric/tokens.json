{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Hemispheric design tokens — 3 capas: primitive → semantic → component",

  "primitive": {
    "color": {
      "neutral": {
        "0":    { "$value": "#0A0A0A", "$type": "color", "$description": "Negro profundo (base dark)" },
        "50":   { "$value": "#0D0D0D", "$type": "color" },
        "100":  { "$value": "#111111", "$type": "color" },
        "150":  { "$value": "#1A1A1A", "$type": "color" },
        "200":  { "$value": "#222222", "$type": "color" },
        "300":  { "$value": "#333333", "$type": "color" },
        "400":  { "$value": "#525252", "$type": "color" },
        "500":  { "$value": "#737373", "$type": "color" },
        "600":  { "$value": "#A3A3A3", "$type": "color" },
        "700":  { "$value": "#D4D4D4", "$type": "color" },
        "800":  { "$value": "#E5E5E5", "$type": "color" },
        "850":  { "$value": "#F4F4F5", "$type": "color" },
        "900":  { "$value": "#F5F5F5", "$type": "color" },
        "950":  { "$value": "#FAFAFA", "$type": "color" },
        "1000": { "$value": "#FFFFFF", "$type": "color" }
      },
      "amber": {
        "900": { "$value": "#78350F", "$type": "color" },
        "800": { "$value": "#92400E", "$type": "color" },
        "700": { "$value": "#B45309", "$type": "color", "$description": "Acento principal dark" },
        "600": { "$value": "#D97706", "$type": "color" },
        "100": { "$value": "#FEF3C7", "$type": "color" },
        "50":  { "$value": "#FFFBEB", "$type": "color" }
      },
      "red": {
        "500": { "$value": "#EF4444", "$type": "color" },
        "600": { "$value": "#DC2626", "$type": "color" }
      }
    },
    "font": {
      "family": {
        "display": { "$value": "'Instrument Serif', Georgia, serif", "$type": "fontFamily" },
        "sans":    { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily" },
        "mono":    { "$value": "'Geist Mono', 'JetBrains Mono', 'Fira Code', monospace", "$type": "fontFamily" }
      },
      "size": {
        "xs":   { "$value": "0.75rem",   "$type": "dimension" },
        "sm":   { "$value": "0.875rem",  "$type": "dimension" },
        "base": { "$value": "1rem",      "$type": "dimension" },
        "lg":   { "$value": "1.125rem",  "$type": "dimension" },
        "xl":   { "$value": "1.25rem",   "$type": "dimension" },
        "2xl":  { "$value": "1.5rem",    "$type": "dimension" },
        "3xl":  { "$value": "1.875rem",  "$type": "dimension" },
        "4xl":  { "$value": "2.25rem",   "$type": "dimension" },
        "5xl":  { "$value": "3rem",      "$type": "dimension" },
        "6xl":  { "$value": "3.75rem",   "$type": "dimension" },
        "7xl":  { "$value": "4.5rem",    "$type": "dimension" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium":  { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold":    { "$value": "700", "$type": "fontWeight" }
      },
      "lineHeight": {
        "none":    { "$value": "1",    "$type": "number" },
        "tight":   { "$value": "1.25", "$type": "number" },
        "snug":    { "$value": "1.375", "$type": "number" },
        "normal":  { "$value": "1.5",  "$type": "number" },
        "relaxed": { "$value": "1.625", "$type": "number" }
      }
    },
    "spacing": {
      "1":  { "$value": "0.25rem", "$type": "dimension" },
      "2":  { "$value": "0.5rem",  "$type": "dimension" },
      "3":  { "$value": "0.75rem", "$type": "dimension" },
      "4":  { "$value": "1rem",    "$type": "dimension" },
      "6":  { "$value": "1.5rem",  "$type": "dimension" },
      "8":  { "$value": "2rem",    "$type": "dimension" },
      "12": { "$value": "3rem",    "$type": "dimension" },
      "16": { "$value": "4rem",    "$type": "dimension" },
      "24": { "$value": "6rem",    "$type": "dimension" },
      "32": { "$value": "8rem",    "$type": "dimension" }
    },
    "radius": {
      "sm":   { "$value": "0.25rem", "$type": "dimension" },
      "md":   { "$value": "0.5rem",  "$type": "dimension" },
      "lg":   { "$value": "0.75rem", "$type": "dimension" },
      "xl":   { "$value": "1rem",    "$type": "dimension" },
      "full": { "$value": "9999px",  "$type": "dimension" }
    },
    "duration": {
      "fast":   { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "250ms", "$type": "duration" },
      "slow":   { "$value": "400ms", "$type": "duration" },
      "reveal": { "$value": "600ms", "$type": "duration" }
    },
    "easing": {
      "out":     { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",    "$type": "cubicBezier" },
      "in-out":  { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",     "$type": "cubicBezier" },
      "spring":  { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  },

  "semantic": {
    "$description": "Semánticos: propósito. Solo la capa semántica cambia entre light/dark.",
    "dark": {
      "background":      { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
      "surface":         { "$value": "{primitive.color.neutral.100}",  "$type": "color" },
      "surface-raised":  { "$value": "{primitive.color.neutral.150}",  "$type": "color" },
      "border":          { "$value": "{primitive.color.neutral.200}",  "$type": "color" },
      "border-strong":   { "$value": "{primitive.color.neutral.300}",  "$type": "color" },
      "foreground":      { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
      "muted":           { "$value": "{primitive.color.neutral.600}",  "$type": "color" },
      "subtle":          { "$value": "{primitive.color.neutral.400}",  "$type": "color" },
      "accent":          { "$value": "{primitive.color.amber.700}",    "$type": "color" },
      "accent-glow":     { "$value": "{primitive.color.amber.800}",    "$type": "color" },
      "on-accent":       { "$value": "{primitive.color.amber.100}",    "$type": "color" },
      "code-bg":         { "$value": "{primitive.color.neutral.50}",   "$type": "color" },
      "destructive":     { "$value": "{primitive.color.red.500}",      "$type": "color" }
    },
    "light": {
      "background":      { "$value": "{primitive.color.neutral.950}",  "$type": "color" },
      "surface":         { "$value": "{primitive.color.neutral.1000}", "$type": "color" },
      "surface-raised":  { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
      "border":          { "$value": "{primitive.color.neutral.800}",  "$type": "color" },
      "border-strong":   { "$value": "{primitive.color.neutral.700}",  "$type": "color" },
      "foreground":      { "$value": "{primitive.color.neutral.0}",    "$type": "color" },
      "muted":           { "$value": "{primitive.color.neutral.500}",  "$type": "color" },
      "subtle":          { "$value": "{primitive.color.neutral.600}",  "$type": "color" },
      "accent":          { "$value": "{primitive.color.amber.800}",    "$type": "color" },
      "accent-glow":     { "$value": "{primitive.color.amber.900}",    "$type": "color" },
      "on-accent":       { "$value": "{primitive.color.amber.50}",     "$type": "color" },
      "code-bg":         { "$value": "{primitive.color.neutral.850}",  "$type": "color" },
      "destructive":     { "$value": "{primitive.color.red.600}",      "$type": "color" }
    }
  },

  "component": {
    "$description": "Tokens por componente. Solo cuando el componente necesita desviarse del semántico.",
    "cortex": {
      "node-color":     { "$value": "{semantic.dark.foreground}",   "$type": "color" },
      "node-active":    { "$value": "{semantic.dark.accent}",       "$type": "color" },
      "edge-color":     { "$value": "{semantic.dark.border-strong}", "$type": "color" },
      "glow":           { "$value": "rgba(180, 83, 9, 0.2)",         "$type": "color" },
      "bg":             { "$value": "{semantic.dark.background}",   "$type": "color" },
      "label-font":     { "$value": "{primitive.font.family.mono}",  "$type": "fontFamily" },
      "label-size":     { "$value": "0.625rem",                      "$type": "dimension" },
      "animation-duration": { "$value": "{primitive.duration.slow}", "$type": "duration" }
    },
    "button-primary": {
      "bg":       { "$value": "{semantic.dark.accent}",      "$type": "color" },
      "fg":       { "$value": "{semantic.dark.on-accent}",   "$type": "color" },
      "radius":   { "$value": "{primitive.radius.md}",       "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.6}",      "$type": "dimension" },
      "padding-y": { "$value": "{primitive.spacing.3}",      "$type": "dimension" }
    },
    "code-block": {
      "bg":        { "$value": "{semantic.dark.code-bg}",    "$type": "color" },
      "fg":        { "$value": "{semantic.dark.foreground}", "$type": "color" },
      "font":      { "$value": "{primitive.font.family.mono}", "$type": "fontFamily" },
      "radius":    { "$value": "{primitive.radius.lg}",      "$type": "dimension" }
    }
  }
}
